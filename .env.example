# Panel runtime
PORT=3000
NODE_ENV=production

# Backend adapter settings (never expose these in Vite client variables)
ADAPTER_API_URL=http://adapter:8787
ADAPTER_API_TOKEN=replace-with-a-long-random-token
SESSION_ENCRYPTION_KEY=replace-with-32-byte-secret

# Optional persistence (add a real database before production)
DATABASE_URL=postgresql://tdf:change-me@db:5432/tdf_botops
